# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# mock: 키 없이 가짜 응답으로 동작 / live: 실제 API 호출
AI_MODE=mock

# Google AI Studio (Pro 크레딧이 연결된 Cloud 프로젝트에서 발급) — 대화 엔진, 그림 인식, 삽화
GEMINI_API_KEY=

# Groq (console.groq.com/keys) — 음성인식(Whisper), 대화 엔진(gpt-oss-120b)
GROQ_API_KEY=

# 대화 엔진 공급자 순서. 앞이 실패하면 다음으로 넘어간다 (그림 인식은 항상 Gemini)
LLM_PROVIDERS=groq,gemini

# 삽화 생성 (ILL-01). cloudflare(무료 하루 10,000 뉴런) 또는 pollinations
IMAGE_PROVIDER=cloudflare
# Cloudflare 대시보드의 계정 ID, 그리고 Workers AI 권한이 있는 API 토큰
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# pollinations를 쓸 때: enter.pollinations.ai에서 발급한 sk_ 키
POLLINATIONS_API_KEY=
# 아이 그림을 참조할 수 있는 모델 (cloudflare: @cf/black-forest-labs/flux-2-klein-4b,
# pollinations: black-forest-labs/flux.2-klein-4b)
IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# 코드 오류로 생성이 반복되지 않도록 서버 하나당 시간당 최대 생성 수
IMAGE_MAX_PER_HOUR=60
